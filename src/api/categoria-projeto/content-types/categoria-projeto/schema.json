{
  "kind": "collectionType",
  "collectionName": "categoria_projetos",
  "info": {
    "singularName": "categoria-projeto",
    "pluralName": "categoria-projetos",
    "displayName": "Categoria de Projetos",
    "description": "Categorias e tags para filtragem de projetos corporativos"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "Nome": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "slug": {
      "type": "uid",
      "targetField": "Nome",
      "required": true
    },
    "Ordem": {
      "type": "integer",
      "default": 0
    },
    "projetos": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::projeto.projeto",
      "mappedBy": "categorias"
    }
  }
}
